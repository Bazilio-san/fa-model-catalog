{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "preserve",
  "ignorePatterns": [
    "**/.idea/**",
    "**/.junie/**",
    "**/.run/**",
    "**/.runtime/**",
    "**/_archive/**",
    "**/_input/**",
    "**/_logs/**",
    "**/_misc_/**",
    "**/_temp/**",
    "**/_tmp/**",
    "node_modules/**",
    "**/dist/**",
    "coverage/**",
    "servers.local.md",
    "config/*.local.yaml",
    ".agents/skills/deploy/config/*.local.yaml",
    ".agents/skills/deploy/config/config.local.yaml",
    "catalog.yaml"
  ]
}
